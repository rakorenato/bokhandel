{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=bokhandel.db"
  },
  "Jwt": {
    "Issuer": "BokhandelApi",
    "Audience": "BokhandelClient",
    "ExpiresInHours": 4
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
